# Application
APP_NAME="Product Distribution System"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
# For local development (asyncpg for async operations)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/product_distribution
# For Docker/Podman (use 'db' as host when running in containers)
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/product_distribution
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Database credentials (used by Docker Compose)
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=product_distribution
DB_PORT=5432
API_PORT=8000

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# Analytics
ANALYTICS_ENABLED=True
ANALYTICS_BATCH_SIZE=100

# AI & LLM
# Get your API key from: https://platform.openai.com/api-keys
# Leave empty to run without AI insights (service will operate in degraded mode)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ngrok - Public URL exposure
# Get your token from: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
NGROK_ENABLED=False
