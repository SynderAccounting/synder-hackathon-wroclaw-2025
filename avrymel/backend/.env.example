# Example environment variables
# Copy this file to .env and update values

# API Configuration
PROJECT_NAME="Retail Data Unification Platform - Mock API"
API_V1_STR="/api/v1"

# Security (Change in production!)
SECRET_KEY="mock-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL="postgresql+asyncpg://synderhacks:synderhacks_dev_password@localhost:5432/synderhacks_dev_db"

# LLM / Chat Configuration
MODEL_PROVIDER="openai"  # 'openai' or 'anthropic'
MODEL_NAME="gpt-4o"  # or 'gpt-4', 'claude-3-opus-20240229', etc.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY="your-anthropic-api-key-here"

# CORS - Add your frontend URLs
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
