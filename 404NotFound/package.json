    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.4",
    "esbuild": "^0.25.0",
    "sass": "^1.83.4",
    "tsx": "^4.20.5",
    "typescript": "5.6.3",
    "vite": "^5.4.20",
    "vite-plugin-vuetify": "^2.0.4",
    "vue-tsc": "^2.1.10"
  },
